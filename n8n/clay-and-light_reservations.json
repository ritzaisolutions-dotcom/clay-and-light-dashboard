body.marketing_consent === 'true',\n      avg_spend_per_person: avgSpend,\n      estimated_revenue: persons * avgSpend,\n      status: 'confirmed',\n      reminderAt: reminderAt.toISOString(),\n      formattedTime: resDate.toLocaleString('de-AT', {\n        timeZone: 'Europe/Vienna', weekday: 'long', year: 'numeric',\n        month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'\n      })\n    }\n  }];"
