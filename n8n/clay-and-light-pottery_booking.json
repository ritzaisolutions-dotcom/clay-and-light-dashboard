      "parameters": {
        "jsCode": "  let body;\n  const input = $input.first().json;\n\n  // ── Secret verification ──────────────────────────────────────────────\n  // Reject any request that did not come through the Next.js API proxy.\n  // Set WEBHOOK_SECRET in n8n Settings → Environment variables.\n  const incoming = (input.headers || {})['x-webhook-secret'];\n  const expected = $env.WEBHOOK_SECRET;\n  if (!expected) throw new Error('Server misconfiguration: WEBHOOK_SECRET env var not set in n8n');\n  if (incoming !== expected) throw new Error('Unauthorized: invalid or missing webhook secret');\n\n  if (typeof input.body === 'string') {\n    try { body = JSON.parse(input.body); }\n    catch(e) { throw new Error('Could not parse body: ' + e.message); }\n  } else if (input.body && typeof input.body === 'object') {\n    body = input.body;\n  } else if (input.name || input.email || input.type) {\n    body = input;\n  } else {\n    throw new Error('Unexpected input: ' + JSON.stringify(input).slice(0, 300));\n  }\n\n  if (body.type === 'payment_intent') {\n    return [{ json: { __type: 'payment_intent', ...body } }];\n  }\n\n  const required = ['name', 'email', 'timeslot', 'persons'];\n  const missing = required.filter(f => !body[f]);\n  if (missing.length > 0) throw new Error('Missing required fields: ' + missing.join(', '));\n\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(body.email)) throw new Error('Invalid email address');\n\n  const persons = parseInt(body.persons);\n  if (persons < 1 || persons > 20) throw new Error('Persons must be between 1 and 20');\n\n  // ── Pricing: always use the server-set value from the API route ───────\n  // Never trust price_per_person from the request body — the Next.js API\n  // route fetches the authoritative price from Supabase settings and sends\n  // it here. If that value is missing or invalid, fall back to the floor\n  // price. This prevents callers from manipulating booking revenue figures.\n  const priceFromApi = parseFloat(body.price_per_person);\n  const pricePerPerson = (Number.isFinite(priceFromApi) && priceFromApi > 0) ? priceFromApi : 45;\n  const totalPrice = persons * pricePerPerson;\n\n  const slotDate = new Date(body.timeslot);\n  const reminderAt = new Date(slotDate.getTime() - 24 * 60 * 60 * 1000);\n\n  return [{\n    json: {\n      __type: 'pottery_booking',\n      id: body.booking_id,\n      name: body.name.trim(),\n      email: body.email.trim().toLowerCase(),\n      phone: body.phone || null,\n      timeslot: slotDate.toISOString(),\n      persons,\n      price_per_person: pricePerPerson,\n      total_price: totalPrice,\n      notes: body.notes || null,\n      marketing_consent: body.marketing_consent === true || body.marketing_consent === 'true',\n      status: 'confirmed',\n      reminderAt: reminderAt.toISOString(),\n      formattedTimeslot: slotDate.toLocaleString('de-AT', {\n        timeZone: 'Europe/Vienna', weekday: 'long', year: 'numeric',\n        month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'\n      })\n    }\n  }];"
