# ============================================================
# Clay & Light — Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# Supabase — get these from your Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shared secret between Next.js API routes and n8n workflows — server-side only
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also set WEBHOOK_SECRET in n8n Settings → Environment variables (same value)
N8N_WEBHOOK_SECRET=generate-a-strong-random-secret-here

# n8n Webhook URLs — server-side only (never expose to browser)
# Pottery booking workflow receives: name, email, phone, timeslot, persons,
#   notes, marketing_consent, price_per_person, total_price
# Must respond: { "success": true, "id": "<record-id>" }
N8N_POTTERY_WEBHOOK=https://your-n8n-instance.com/webhook/pottery-booking

# Table reservation workflow receives: name, email, phone, reservation_time,
#   persons, notes, avg_spend_per_person, estimated_revenue
# Must respond: { "success": true, "id": "<record-id>" }
N8N_RESERVATION_WEBHOOK=https://your-n8n-instance.com/webhook/table-reservation

# Cookiebot (GDPR)
NEXT_PUBLIC_COOKIEBOT_ID=your-cookiebot-cbid-here

# Optional: Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
